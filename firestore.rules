rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'name', 'email', 'country', 'school'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'country', 'school'
        ]);

      match /journalEntries/{entryId} {
        allow get, create, update, delete: if false;
      }
    }

    match /Userdata/Journalentries {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['type'])
        && request.resource.data.keys().hasOnly(['type'])
        && request.resource.data.type == 'journalEntries';

      match /entries/{entryId} {
        allow get: if signedIn()
          && entryId.matches(
            '^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          );

        function isValidEntry() {
          return signedIn()
            && request.resource.data.keys().hasAll([
              'userId', 'day', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'userId', 'day', 'text', 'image', 'updatedAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.day is string
            && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && entryId == request.auth.uid + '_' + request.resource.data.day
            && request.resource.data.updatedAt == request.time
            && (
              (
                'text' in request.resource.data
                && request.resource.data.text is string
                && (
                  request.resource.data.text.size() > 0
                  || 'image' in request.resource.data
                )
              )
              || 'image' in request.resource.data
            )
            && (
              !('image' in request.resource.data)
              || (
                request.resource.data.image is string
                && request.resource.data.image.matches(
                  '^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'
                )
                && request.resource.data.image.size() <= 600000
              )
            );
        }

        allow create, update: if isValidEntry();
        allow delete: if false;
      }
    }
  }
}
